generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id           String        @id @default(cuid())
  userId       String? // dono (id do usuário no Supabase Auth); null = dado antigo ainda não reivindicado
  name         String // "Nubank", "Carteira", "Bradesco"
  type         String // corrente | poupança | carteira
  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String? // dono (id do usuário no Supabase Auth); null = dado antigo ainda não reivindicado
  name         String // "Moradia", "Alimentação"
  type         String // receita | despesa
  color        String // hex: "#F87171"
  icon         String? // emoji ou ícone opcional
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String? // dono (id do usuário no Supabase Auth); null = dado antigo ainda não reivindicado
  description String
  amount      Decimal  @db.Decimal(12, 2)
  type        String // receita | despesa
  date        DateTime
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())

  // Parcelas: todas as parcelas de uma compra compartilham o mesmo grupo.
  // A descrição ainda leva o sufixo "(n/N)" só para exibição.
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  @@index([userId])
  @@index([date])
  @@index([type])
  @@index([installmentGroupId])
}

model Investment {
  id             String   @id @default(cuid())
  userId         String? // dono (id do usuário no Supabase Auth); null = dado antigo ainda não reivindicado
  asset          String // "Tesouro Selic 2029", "IVVB11"
  assetType      String // renda_fixa | renda_variavel | cripto | fundo
  investedAmount Decimal  @db.Decimal(12, 2)
  currentAmount  Decimal  @db.Decimal(12, 2)
  date           DateTime
  notes          String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model Goal {
  id            String    @id @default(cuid())
  userId        String? // dono (id do usuário no Supabase Auth); null = dado antigo ainda não reivindicado
  name          String // "Reserva de emergência"
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @db.Decimal(12, 2)
  deadline      DateTime?
  color         String    @default("#FBBF24")
  createdAt     DateTime  @default(now())

  @@index([userId])
}
