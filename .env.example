# Postgres (Supabase). DATABASE_URL = conexão pooled (porta 6543, pgbouncer=true),
# usada em runtime. DIRECT_URL = conexão direta (porta 5432), usada só por `prisma migrate`.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase Auth (Project Settings → API). Chaves públicas por definição.
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Endereço público do app, usado nos links dos e-mails de confirmação e
# recuperação de senha. Na Vercel, sem ele, usa o domínio de produção do
# projeto; em outro host de produção é obrigatório.
NEXT_PUBLIC_SITE_URL="https://seu-app.vercel.app"

# E-mail do dono dos dados de antes do multiusuário: no primeiro login desse
# e-mail, tudo que ainda não tem dono passa a ser dele.
LEGACY_OWNER_EMAIL="voce@exemplo.com"
